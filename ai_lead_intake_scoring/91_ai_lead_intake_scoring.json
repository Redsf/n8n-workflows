              "name": "company",
              "value": "={{ ($json.body.company || '').trim() }}",
              "type": "string"
            },
            {
              "id": "n5",
              "name": "website",
              "value": "={{ ($json.body.website || '').trim() }}",
              "type": "string"
            },
            {
