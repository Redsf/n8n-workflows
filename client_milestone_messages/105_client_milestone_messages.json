    {
      "id": "2929ee7d-62df-4f32-80c5-04d05ce509fa",
      "name": "Find Milestones Today",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Birthdays and home (or policy) anniversaries that fall on today's month and day.\nconst s = $('Message Settings').first().json;\nconst out = [];\nfor (const item of $input.all()) {\n  const c = item.json;\n  if (!c.email) continue;\n  const md = d => String(d || '').slice(5, 10);\n  const base = { name: c.name, firstName: (c.name || 'there').split(' ')[0], email: c.email, phone: c.phone || '', detail: c.propertyAddress || '',\n    notes: c.notes || '', agentName: c.agent || s.agentName, businessName: s.businessName };\n  if (c.birthday && md(c.birthday) === s.today) out.push({ json: { ...base, occasion: 'birthday', years: '' } });\n  if (c.closeDate && md(c.closeDate) === s.today) {\n    const years = s.year - Number(String(c.closeDate).slice(0, 4));\n    if (years > 0) out.push({ json: { ...base, occasion: 'home anniversary', years } });\n  }\n}\nreturn out;"
      }
    },
    {
      "id": "894fd26f-be44-493d-9cc4-9d39f50db9eb",
