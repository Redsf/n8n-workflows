    {
      "id": "2d4c8627-ea1b-4569-960d-16021b02857e",
      "name": "Find Lapsed Customers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Customers with no order for inactiveDays (but under a year), who have not had a win-back email in the last 90 days.\nconst s = $('Win-back Settings').first().json;\nconst today = new Date(s.today + 'T00:00:00Z');\nconst days = d => Math.round((today - new Date(String(d).slice(0, 10) + 'T00:00:00Z')) / 86400000);\nreturn $input.all().map(i => i.json)\n  .filter(c => c.email && c.lastOrderDate && days(c.lastOrderDate) >= s.inactiveDays && days(c.lastOrderDate) < 365)\n  .filter(c => !c.winbackSentAt || days(c.winbackSentAt) > 90)\n  .sort((a, b) => Number(b.totalSpent || 0) - Number(a.totalSpent || 0))\n  .slice(0, s.maxPerRun)\n  .map(c => ({ json: { row_number: c.row_number, firstName: (c.name || 'there').split(' ')[0], email: c.email, lastOrderDate: c.lastOrderDate,\n    daysSince: days(c.lastOrderDate), orderCount: c.orderCount || 1, totalSpent: c.totalSpent || 0, favoriteProduct: c.favoriteProduct || '',\n    businessName: s.businessName, offer: s.offer, offerCode: s.offerCode, shopLink: s.shopLink } }));"
      }
    },
    {
      "id": "de23cc13-b748-4155-855b-2e1986d72a4c",
      "name": "Write Win-back Email",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        896,
        0
      ],
      "parameters": {
        "promptType": "define",
        "hasOutputParser": true,
        "text": "=Customer: {{ $json.firstName }}\nLast order: {{ $json.lastOrderDate }} ({{ $json.daysSince }} days ago)\nOrders so far: {{ $json.orderCount }}  Total spent: ${{ $json.totalSpent }}\nFavourite product: {{ $json.favoriteProduct || 'unknown' }}\nOffer: {{ $json.offer }} with code {{ $json.offerCode }}\nShop link: {{ $json.shopLink }}",
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "=You write short win-back emails for {{ $json.businessName }}. Friendly, specific to what the customer bought, never guilt-trip. 4 sentences max, plain text, no emojis. Include the offer code exactly once and the shop link once."
            }
          ]
        }
      }
    },
