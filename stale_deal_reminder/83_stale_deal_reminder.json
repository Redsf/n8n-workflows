    {
      "id": "470ce848-bae5-4752-b0d3-3287c96180f9",
      "name": "Find Untouched Open Deals",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2.2,
      "position": [
        448,
        400
      ],
      "parameters": {
        "resource": "deal",
        "operation": "search",
        "authentication": "oAuth2",
        "returnAll": true,
        "filterGroupsUi": {
          "filterGroupsValues": [
            {
              "filtersUi": {
                "filterValues": [
                  {
                    "propertyName": "notes_last_updated|datetime",
                    "operator": "LT",
                    "value": "={{ $json.staleCutoffMs }}"
                  },
                  {
                    "propertyName": "dealstage|enumeration",
                    "operator": "NEQ",
                    "value": "closedwon"
                  },
                  {
                    "propertyName": "dealstage|enumeration",
                    "operator": "NEQ",
                    "value": "closedlost"
                  }
                ]
              }
            },
            {
              "filtersUi": {
                "filterValues": [
                  {
                    "propertyName": "notes_last_updated|datetime",
                    "operator": "NOT_HAS_PROPERTY"
                  },
                  {
                    "propertyName": "createdate|datetime",
                    "operator": "LT",
                    "value": "={{ $json.staleCutoffMs }}"
                  },
                  {
                    "propertyName": "hs_is_closed|bool",
                    "operator": "NEQ",
                    "value": "true"
                  }
                ]
              }
            }
          ]
        },
        "additionalFields": {
          "properties": [
            "dealname",
            "amount",
            "dealstage",
            "hubspot_owner_id",
            "notes_last_updated",
            "createdate",
            "closedate",
            "description"
          ]
        }
      },
      "credentials": {
        "hubspotOAuth2Api": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "HubSpot account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "d43bd354-f16b-4438-8c91-54758cf89a05",
      "name": "Get Deal Owners",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        672,
        400
      ],
      "parameters": {
        "method": "GET",
        "url": "https://api.hubapi.com/crm/v3/owners?limit=500&archived=false",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotOAuth2Api",
        "options": {}
      },
      "credentials": {
        "hubspotOAuth2Api": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "HubSpot account"
        }
      },
      "executeOnce": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "fb994f18-ef12-42a0-a19f-d905ca0900e0",
      "name": "Score Stale Deals",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const settings = $('Pipeline Settings').first().json;\nconst owners = $('Get Deal Owners').first().json.results ?? [];\nconst ownerById = Object.fromEntries(owners.map((o) => [String(o.id), o]));\nconst now = DateTime.now();\n\nreturn $('Find Untouched Open Deals').all().map(({ json }) => {\n  const p = json.properties ?? {};\n  const lastTouch = p.notes_last_updated || p.createdate;\n  const daysIdle = Math.floor(now.diff(DateTime.fromISO(lastTouch), 'days').days);\n  const owner = ownerById[String(p.hubspot_owner_id)] ?? null;\n  return {\n    json: {\n      dealId: json.id,\n      dealName: p.dealname || 'Untitled deal',\n      amount: Number(p.amount || 0),\n      stage: p.dealstage || 'unknown',\n      description: p.description || '',\n      closeDate: p.closedate ? DateTime.fromISO(p.closedate).toISODate() : '',\n      daysIdle,\n      ownerId: owner ? String(owner.id) : '',\n      ownerName: owner ? `${owner.firstName ?? ''} ${owner.lastName ?? ''}`.trim() || owner.email : 'Unassigned',\n      ownerEmail: owner?.email ?? '',\n      newlyStale: daysIdle >= settings.staleDays && daysIdle < settings.staleDays + 3,\n      escalate: daysIdle >= settings.escalateDays,\n      dealUrl: `https://app.hubspot.com/contacts/${settings.hubspotPortalId}/record/0-3/${json.id}`,\n    },\n  };\n}).filter((i) => i.json.daysIdle >= settings.staleDays);"
      }
    },
    {
      "id": "299ae630-0470-48b2-ab92-2110aa0941c2",
      "name": "Suggest Next Step",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Deal: {{ $json.dealName }}\nStage: {{ $json.stage }}\nValue: ${{ $json.amount }}\nExpected close: {{ $json.closeDate || \"not set\" }}\nDays since last activity: {{ $json.daysIdle }}\nNotes: {{ $json.description || \"none\" }}",
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "You are a sales coach. Reply with ONE concrete next step for the rep, max 18 words, starting with a verb. No preamble, no quotes. Do not invent facts about the client."
            }
          ]
        },
        "batching": {
          "batchSize": 5,
          "delayBetweenBatches": 500
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "caa0c0b2-d780-4b02-9de3-b574a841c712",
      "name": "Claude Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.6,
      "position": [
        1200,
        224
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "claude-haiku-5-5"
        },
        "options": {
          "maxTokensToSample": 120
        }
      },
      "credentials": {}
    },
    {
      "id": "a04295c1-0879-4d22-a025-fc75756cf66e",
      "name": "Build Owner Digests",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1472,
        112
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const deals = $('Score Stale Deals').all().map((d) => d.json);\nconst steps = $input.all().map((i) => (i.json.text || '').trim());\nconst money = (n) => '$' + Number(n || 0).toLocaleString('en-US');\nconst byOwner = {};\n\ndeals.forEach((deal, idx) => {\n  const key = deal.ownerId || 'unassigned';\n  byOwner[key] = byOwner[key] ?? { ownerName: deal.ownerName, ownerEmail: deal.ownerEmail, deals: [] };\n  byOwner[key].deals.push({ ...deal, nextStep: steps[idx] || 'Review the deal and log the next action.' });\n});\n\nreturn Object.values(byOwner).map((group) => {\n  const sorted = group.deals.sort((a, b) => b.daysIdle - a.daysIdle);\n  const lines = sorted.map((d) => `${d.escalate ? ':red_circle:' : ':large_yellow_circle:'} <${d.dealUrl}|${d.dealName}> (${money(d.amount)}, ${d.daysIdle} days idle)\\n      Next step: ${d.nextStep}`);\n  return {\n    json: {\n      ownerName: group.ownerName,\n      ownerEmail: group.ownerEmail,\n      dealCount: sorted.length,\n      totalValue: money(sorted.reduce((s, d) => s + d.amount, 0)),\n      digest: lines.join('\\n'),\n    },\n  };\n});"
      }
    },
    {
