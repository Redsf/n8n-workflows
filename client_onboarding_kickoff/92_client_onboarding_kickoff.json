                "singleValue": true
              },
              "rightValue": ""
            },
            {
              "leftValue": "={{ $json.clientName }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
