          "value": {
            "receivedAt": "={{ $now.toISO() }}",
            "taxpayer": "={{ $('Calculate Deadline').item.json.notice.taxpayerName }}",
            "agency": "={{ $('Calculate Deadline').item.json.notice.agency }}",
            "noticeCode": "={{ $('Calculate Deadline').item.json.notice.noticeCode }}",
            "taxYear": "={{ $('Calculate Deadline').item.json.notice.taxYear }}",
            "amountDue": "={{ $('Calculate Deadline').item.json.notice.amountDue }}",
            "deadline": "={{ $('Calculate Deadline').item.json.deadline }}",
            "confidence": "={{ $('Calculate Deadline').item.json.notice.confidence }}",
            "file": "={{ $('Calculate Deadline').item.json.fileName }}"
          },
          "schema": []
        },
        "options": {}
      },
      "credentials": {
