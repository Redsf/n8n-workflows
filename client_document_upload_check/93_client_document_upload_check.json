      "parameters": {
        "promptType": "define",
        "hasOutputParser": true,
        "text": "=Checklist still needed: {{ $('Find Client in Tracker').first().json.missingDocs }}\nFile name: {{ $('Split Uploaded Files').item.json.fileName }}\nFirst pages of text:\n{{ ($json.text || '(no text could be read; it may be a photo or scan)').slice(0, 6000) }}",
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "You check client onboarding documents. Pick the ONE checklist item this file satisfies, copied exactly from the checklist, or \"\" if none. readable=false if the text is empty, cut off or clearly the wrong period. issue = one short sentence for the client when something is wrong, else \"\"."
            }
          ]
        }
      }
    },
