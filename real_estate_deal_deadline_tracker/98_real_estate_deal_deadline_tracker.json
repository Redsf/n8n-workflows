    {
      "id": "f7bb092e-7b0c-4ecd-afb8-865cfbf0d8b4",
      "name": "Remind Agent",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        896,
        192
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.agentEmail }}",
        "subject": "={{ $json.daysLeft === 0 ? 'TODAY' : 'In ' + $json.daysLeft + ' day(s)' }}: {{ $json.milestone }} - {{ $json.address }}",
        "emailType": "text",
        "message": "=Hi {{ ($json.agentName || '').split(' ')[0] || 'there' }},\n\n{{ $json.milestone }} for {{ $json.address }} ({{ $json.client }}) is on {{ $json.date }}{{ $json.daysLeft === 0 ? ', which is today' : ', ' + $json.daysLeft + ' day(s) from now' }}.\n\nWhen it is handled, mark it done in the deal tracker so the reminders stop.",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Gmail account"
        }
