    {
      "id": "085b2ec4-444b-46e9-b657-94c2d2cdbb3a",
      "name": "Normalize Lead",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        448,
        192
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "n1",
              "name": "firstName",
              "value": "={{ String($json.body?.firstName ?? $json.firstName ?? \"\").trim() || \"there\" }}",
              "type": "string"
            },
            {
              "id": "n2",
              "name": "lastName",
              "value": "={{ String($json.body?.lastName ?? $json.lastName ?? \"\").trim() }}",
              "type": "string"
            },
            {
              "id": "n3",
              "name": "email",
              "value": "={{ String($json.body?.email ?? $json.email ?? \"\").trim().toLowerCase() }}",
              "type": "string"
            },
            {
              "id": "n4",
              "name": "phone",
              "value": "={{ (() => { const d = String($json.body?.phone ?? $json.phone ?? \"\").replace(/\\D/g, \"\"); if (d.length === 10) return \"+1\" + d; if (d.length === 11 && d.startsWith(\"1\")) return \"+\" + d; return d.length >= 8 ? \"+\" + d : \"\"; })() }}",
              "type": "string"
            },
            {
              "id": "n5",
              "name": "company",
              "value": "={{ String($json.body?.company ?? $json.company ?? \"\").trim() }}",
              "type": "string"
            },
            {
              "id": "n6",
              "name": "message",
              "value": "={{ String($json.body?.message ?? $json.message ?? \"\").trim().slice(0, 1000) }}",
              "type": "string"
            },
            {
              "id": "n7",
              "name": "source",
              "value": "={{ $json.body?.source ?? $json.source ?? \"website\" }}",
              "type": "string"
            },
            {
              "id": "n8",
              "name": "receivedAt",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "649a5c38-eeeb-4af9-821d-81093956c3ee",
      "name": "Valid Lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        672,
        192
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test($json.email) }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "964e86d4-df31-45f4-a2fc-4dc48094f69d",
