    {
      "id": "82100ed8-ff83-44a6-b570-6a1bc6f0fdaa",
      "name": "Summarize Run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const sent = $('Find Lapsed Customers').all().map(i => i.json);\nconst value = sent.reduce((t, c) => t + Number(c.totalSpent || 0), 0);\nreturn [{ json: { count: sent.length, lifetimeValue: value.toFixed(2), top: sent.slice(0, 5).map(c => `${c.firstName} ($${c.totalSpent}, ${c.daysSince} days)`).join(', ') } }];"
      }
    },
