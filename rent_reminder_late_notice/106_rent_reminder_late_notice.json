    {
      "id": "4dd79228-210e-4f39-bf94-5c1f880c919e",
      "name": "Work Out Rent Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        192
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// For tenants who have not paid this month: reminder 3 days before the due day, late notice the day after, escalation on day 5.\nconst s = $('Rent Settings').first().json;\nconst today = new Date(s.today + 'T00:00:00Z');\nconst month = s.today.slice(0, 7);\nconst due = new Date(Date.UTC(today.getUTCFullYear(), today.getUTCMonth(), s.rentDueDay));\nconst next = new Date(Date.UTC(today.getUTCFullYear(), today.getUTCMonth() + 1, s.rentDueDay));\nconst out = [];\nfor (const item of $input.all()) {\n  const t = item.json;\n  if (!t.tenantName || String(t.paidMonth) === month) continue;\n  const days = Math.round((today - due) / 86400000);\n  const before = Math.round((next - today) / 86400000);\n  let stage = null;\n  if (before === 3 && String(t.paidMonth) !== next.toISOString().slice(0, 7)) stage = 'reminder';\n  else if (days === 1) stage = 'late';\n  else if (days === 5) stage = 'escalate';\n  if (!stage) continue;\n  const rent = Number(t.rent || 0);\n  const fee = stage === 'reminder' ? 0 : s.lateFee;\n  out.push({ json: { row_number: t.row_number, tenantName: t.tenantName, firstName: t.tenantName.split(' ')[0], email: t.email || '', phone: t.phone || '',\n    unit: t.unit, rent: rent.toFixed(2), lateFee: fee, totalDue: (rent + fee).toFixed(2), stage,\n    dueDate: (stage === 'reminder' ? next : due).toISOString().slice(0, 10) } });\n}\nreturn out;"
      }
    },
