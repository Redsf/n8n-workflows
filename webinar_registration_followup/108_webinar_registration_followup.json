    {
      "id": "816b3335-4d4c-4f9f-b7e2-1e1201bc6138",
      "name": "Send Calendar Invite",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.4,
      "position": [
        448,
        96
      ],
      "parameters": {
        "resource": "event",
        "operation": "create",
        "calendar": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.calendarId }}"
        },
        "start": "={{ $json.startTime }}",
        "end": "={{ DateTime.fromISO($json.startTime).plus({ minutes: $json.durationMinutes }).toISO() }}",
        "useDefaultReminders": true,
        "additionalFields": {
          "summary": "={{ $json.title }}",
          "description": "=Join here: {{ $json.joinLink }}",
          "location": "={{ $json.joinLink }}",
          "attendees": [
            "={{ $json.email }}"
          ],
          "sendUpdates": "all",
          "guestsCanSeeOtherGuests": false
        }
      },
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Google Calendar"
        }
      }
    },
