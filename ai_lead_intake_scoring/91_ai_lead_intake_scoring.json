      "position": [
        448,
        240
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "n1",
              "name": "firstName",
              "value": "={{ ($json.body.firstName || ($json.body.name || '').split(' ')[0] || '').trim() }}",
