        "emailType": "html",
        "message": "=<p>Hi {{ $('Build Checklist').item.json.contactName.split(' ')[0] }},</p><p>Welcome aboard, we are excited to start your {{ $('Build Checklist').item.json.service }} work.</p><p><b>1. Upload these documents</b> (<a href=\"{{ $('Build Checklist').item.json.uploadLink }}\">secure upload page</a>):</p><ul>{{ $('Build Checklist').item.json.missingDocs.split('; ').map(d => '<li>' + d + '</li>').join('') }}</ul><p><b>2. Book your kickoff call:</b> <a href=\"{{ $('Build Checklist').item.json.kickoffBookingUrl }}\">pick a time</a></p><p>{{ $('Build Checklist').item.json.senderName }}</p>",
        "options": {
          "appendAttribution": false
        }
      },
