    {
      "id": "3b0f5c28-9963-4731-86af-77105291a4d1",
      "name": "Document Check Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1488,
        336
      ],
      "parameters": {
