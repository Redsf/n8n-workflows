    {
      "id": "b55247fe-8489-4542-8a6b-36d2904dea9a",
      "name": "Find Due Renewals",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        192
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Sheet columns: policyNumber, clientName, email, phone, policyType, carrier, premium, renewalDate (YYYY-MM-DD), agent, status, lastNotice\nconst today = new Date(new Date().toISOString().slice(0, 10) + 'T00:00:00Z');\nconst out = [];\nfor (const { json: p } of $input.all()) {\n  if (!p.renewalDate || String(p.status || '').toLowerCase() === 'renewed') continue;\n  const days = Math.round((new Date(p.renewalDate + 'T00:00:00Z') - today) / 86400000);\n  const stage = days === 60 ? '60' : days === 30 ? '30' : days === 7 ? '7' : null;\n  if (!stage || p.lastNotice === stage) continue;\n  out.push({ json: { ...p, daysToRenewal: days, stage, firstName: String(p.clientName || 'there').split(' ')[0] } });\n}\nreturn out;"
      }
    },
    {
