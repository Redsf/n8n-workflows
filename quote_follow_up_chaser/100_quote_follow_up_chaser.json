    {
      "id": "12139149-5b37-40f7-99f3-90ed05207be7",
      "name": "Pick Quotes to Chase",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        192
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Follow up 2, 5 and 10 days after a quote was sent. Rows marked accepted, declined or replied are not read.\nconst today = new Date($('Follow-up Settings').first().json.today + 'T00:00:00Z');\nconst out = [];\nfor (const item of $input.all()) {\n  const q = item.json;\n  if (!q.email || !q.sentDate) continue;\n  const days = Math.round((today - new Date(String(q.sentDate).slice(0, 10) + 'T00:00:00Z')) / 86400000);\n  const step = { 2: 'checkIn', 5: 'nudge', 10: 'final' }[days];\n  if (!step || String(q.lastFollowUp || '').includes(step)) continue;\n  out.push({ json: { row_number: q.row_number, firstName: (q.name || 'there').split(' ')[0], name: q.name, email: q.email, phone: q.phone || '',\n    quoteNumber: q.quoteNumber, amount: q.amount, quoteLink: q.quoteLink || '', owner: q.owner || '', daysSinceSent: days, step,\n    followUps: [q.lastFollowUp, step].filter(Boolean).join(', ') } });\n}\nreturn out;"
      }
    },
    {
      "id": "d217297e-fd7e-4599-ad5b-0ae5a5be1109",
      "name": "Route by Day",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        896,
        192
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "renameOutput": true,
              "outputKey": "checkIn",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.step }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "checkIn"
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "renameOutput": true,
              "outputKey": "nudge",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.step }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "nudge"
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "renameOutput": true,
              "outputKey": "final",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.step }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "final"
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
