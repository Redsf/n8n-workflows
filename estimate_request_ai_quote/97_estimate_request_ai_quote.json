      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{ \"scopeSummary\": \"Spring cleanup of front and back beds, mulch refresh\", \"lineItems\": [{ \"description\": \"Spring cleanup, 2-person crew, est. 4 hours\", \"quantity\": 4, \"unitPrice\": 65, \"amount\": 260 }, { \"description\": \"Mulch install\", \"quantity\": 3, \"unitPrice\": 95, \"amount\": 285 }], \"total\": 545, \"assumptions\": [\"Beds are about 600 sq ft\", \"Debris hauled in one load\"], \"siteVisitNeeded\": false, \"confidence\": \"medium\" }"
      }
