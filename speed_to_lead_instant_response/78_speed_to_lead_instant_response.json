              "type": "string"
            },
            {
              "id": "s3",
              "name": "smsFromNumber",
              "value": "+15555550100",
              "type": "string"
            },
            {
              "id": "s4",
              "name": "senderName",
              "value": "Your Company Team",
              "type": "string"
            },
            {
              "id": "s5",
              "name": "hubspotPortalId",
              "value": "0000000",
