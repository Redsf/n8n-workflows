    {
      "id": "58106bb8-7ae5-4fe5-a5df-81e230e50dc1",
      "name": "Get Overdue Invoices",
      "type": "n8n-nodes-base.quickbooks",
      "typeVersion": 1,
      "position": [
        448,
        192
      ],
      "parameters": {
        "resource": "invoice",
        "operation": "getAll",
        "returnAll": true,
        "filters": {
          "query": "=SELECT * FROM Invoice WHERE Balance > '0' AND DueDate < '{{ $json.today }}'"
        }
      },
      "credentials": {
        "quickBooksOAuth2Api": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "QuickBooks Online"
        }
      }
    },
    {
      "id": "a8783b08-c1a2-4d3d-a325-bd783b93c8db",
      "name": "Pick Invoices to Chase",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        192
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Remind on day 1, 7 and 14 overdue, then every 7 days. Skip invoices without an email.\nconst today = new Date($('Chaser Settings').first().json.today + 'T00:00:00Z');\nconst out = [];\nfor (const item of $input.all()) {\n  const inv = item.json;\n  const email = inv.BillEmail?.Address;\n  if (!email || !inv.DueDate) continue;\n  const days = Math.round((today - new Date(inv.DueDate + 'T00:00:00Z')) / 86400000);\n  const due = days === 1 || days === 7 || days === 14 || (days >= 21 && days % 7 === 0);\n  if (!due) continue;\n  const stage = days < 7 ? 'friendly' : days < 21 ? 'firm' : 'final';\n  out.push({ json: {\n    invoiceId: inv.Id, invoiceNumber: inv.DocNumber || inv.Id, customer: inv.CustomerRef?.name || 'there',\n    email, balance: Number(inv.Balance || 0).toFixed(2), dueDate: inv.DueDate, daysOverdue: days, stage,\n  } });\n}\nreturn out;"
      }
    },
    {
      "id": "dc22d065-70ee-4ff0-a769-cbf7a14c0f6a",
      "name": "Route by Stage",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        896,
        176
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "friendly",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.stage }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "friendly"
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "outputKey": "firm",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.stage }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "firm"
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "outputKey": "final",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.stage }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "final"
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "options": {}
      }
    },
