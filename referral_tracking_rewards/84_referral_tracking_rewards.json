        "responseMode": "responseNode"
      }
    },
    {
      "id": "c8a245b0-fadf-4011-91d5-028c42ccc4ca",
      "name": "Referral Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        464,
        476
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "r1",
              "name": "businessName",
              "value": "Your Company",
              "type": "string"
            },
            {
              "id": "r2",
              "name": "senderName",
              "value": "Alex from Your Company",
              "type": "string"
            },
            {
              "id": "r3",
              "name": "rewardText",
              "value": "a $250 thank-you gift card",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "b615d898-09f3-4e01-b54f-d753aa7af5a9",
      "name": "Normalize Referral",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        688,
        476
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "n1",
              "name": "leadFirstName",
              "value": "={{ String($json.body?.firstName ?? \"\").trim() || \"there\" }}",
              "type": "string"
            },
            {
              "id": "n2",
              "name": "leadLastName",
              "value": "={{ String($json.body?.lastName ?? \"\").trim() }}",
              "type": "string"
            },
            {
              "id": "n3",
              "name": "leadEmail",
              "value": "={{ String($json.body?.email ?? \"\").trim().toLowerCase() }}",
              "type": "string"
            },
            {
              "id": "n4",
              "name": "leadCompany",
              "value": "={{ String($json.body?.company ?? \"\").trim() }}",
              "type": "string"
            },
            {
              "id": "n5",
              "name": "leadPhone",
              "value": "={{ String($json.body?.phone ?? \"\").trim() }}",
              "type": "string"
            },
            {
              "id": "n6",
              "name": "referrerEmail",
              "value": "={{ String($json.body?.referredByEmail ?? $json.body?.referrerEmail ?? \"\").trim().toLowerCase() }}",
              "type": "string"
            },
            {
              "id": "n7",
              "name": "note",
              "value": "={{ String($json.body?.note ?? \"\").trim().slice(0, 500) }}",
              "type": "string"
            },
            {
              "id": "n8",
              "name": "receivedAt",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "eb51b261-5353-4239-8e0c-154df9f4515d",
      "name": "Valid Referral?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        912,
        476
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test($json.leadEmail) && /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test($json.referrerEmail) && $json.leadEmail !== $json.referrerEmail }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "9e010d67-bef9-48f5-befe-b379a7df80f5",
      "name": "Confirm Referral",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        1136,
        380
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{ \"ok\": true, \"message\": \"Thanks! We will be in touch shortly.\" }",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "3cee62d0-ae3c-438d-849b-5955d9562cd9",
      "name": "Find Referrer in HubSpot",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2.2,
      "position": [
        1360,
        380
      ],
      "parameters": {
        "resource": "contact",
        "operation": "search",
        "authentication": "oAuth2",
        "returnAll": false,
        "limit": 1,
        "filterGroupsUi": {
          "filterGroupsValues": [
            {
              "filtersUi": {
                "filterValues": [
                  {
                    "propertyName": "email|string",
                    "operator": "EQ",
                    "value": "={{ $('Normalize Referral').item.json.referrerEmail }}"
                  }
                ]
              }
            }
          ]
        },
        "additionalFields": {
          "properties": [
            "firstname",
            "lastname",
            "email",
            "company"
          ]
        }
      },
      "credentials": {
        "hubspotOAuth2Api": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "HubSpot account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "alwaysOutputData": true
    },
    {
      "id": "56fb36d3-6098-471c-b568-bc97687a58b5",
      "name": "Save Referred Lead",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2.2,
      "position": [
        1584,
        380
      ],
      "parameters": {
        "resource": "contact",
        "operation": "upsert",
        "authentication": "oAuth2",
        "email": "={{ $('Normalize Referral').item.json.leadEmail }}",
        "additionalFields": {
          "firstName": "={{ $('Normalize Referral').item.json.leadFirstName }}",
          "lastName": "={{ $('Normalize Referral').item.json.leadLastName }}",
          "companyName": "={{ $('Normalize Referral').item.json.leadCompany }}",
          "phoneNumber": "={{ $('Normalize Referral').item.json.leadPhone }}",
          "message": "=Referred by {{ $('Normalize Referral').item.json.referrerEmail }}. {{ $('Normalize Referral').item.json.note }}",
          "lifeCycleStage": "lead",
          "customPropertiesUi": {
            "customPropertiesValues": [
              {
                "property": "referred_by_email",
                "value": "={{ $('Normalize Referral').item.json.referrerEmail }}"
              }
            ]
          }
        }
      },
      "credentials": {
        "hubspotOAuth2Api": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "HubSpot account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "7d7f3064-1479-4fb7-b3db-39ea03bc3f97",
      "name": "Referrer in CRM?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1808,
        380
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $('Find Referrer in HubSpot').item.json.id ?? '' }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "cceb4eff-7027-4509-a9b7-a9a64b5529b9",
      "name": "Thank the Referrer",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        2032,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $('Normalize Referral').item.json.referrerEmail }}",
        "subject": "=Thank you for introducing {{ $('Normalize Referral').item.json.leadFirstName }}",
        "emailType": "html",
        "message": "=<div style=\"font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#1a1a1a;max-width:560px\"><p>Hi {{ $('Find Referrer in HubSpot').item.json.properties?.firstname || 'there' }},</p><p>{{ $('Normalize Referral').item.json.leadFirstName }}{{ $('Normalize Referral').item.json.leadCompany ? ' from ' + $('Normalize Referral').item.json.leadCompany : '' }} just reached out and mentioned you. Thank you, referrals like this mean a lot to a team our size.</p><p>We will take good care of them. If they become a client, we will send you {{ $('Referral Settings').item.json.rewardText }} as a thank-you.</p><p>Best,<br>{{ $('Referral Settings').item.json.senderName }}</p></div>",
        "options": {
          "appendAttribution": false,
          "senderName": "={{ $('Referral Settings').item.json.senderName }}"
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
