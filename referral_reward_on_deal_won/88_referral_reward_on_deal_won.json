        "subject": "Your referral just became a client",
        "emailType": "html",
        "message": "=<div style=\"font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#1a1a1a;max-width:560px\"><p>Hi {{ ($('Find Open Referral').item.json.referrerName || '').trim().split(' ')[0] || 'there' }},</p><p>Good news: {{ $('Find Open Referral').item.json.leadName }} is now a client. None of this happens without your introduction.</p><p>As promised, {{ $('Won Deal Details').item.json.rewardText }} is on its way. Our team will send it over in the next few days.</p><p>Thank you again,<br>{{ $('Won Deal Details').item.json.senderName }}</p></div>",
        "options": {
          "appendAttribution": false,
          "senderName": "={{ $('Won Deal Details').item.json.senderName }}"
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
