    {
      "id": "e60d12aa-f02f-4c4f-8310-4194207374d9",
      "name": "Build Checklist",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Documents to collect per service. Edit to match your firm.\nconst lists = {\n  bookkeeping: ['Last 3 months of bank statements', 'Credit card statements', 'Prior year tax return', 'Chart of accounts or last balance sheet'],\n  tax: ['Prior year tax return', 'W-2 and 1099 forms', 'Mortgage interest statement (1098)', 'Photo ID'],\n  payroll: ['Employee list with pay rates', 'Signed W-4 forms', 'Last payroll register', 'State tax account numbers'],\n};\nconst client = $('Normalize Client').item.json;\nconst docs = lists[client.service] || lists.bookkeeping;\nreturn { json: { ...client, folderId: $json.id, missingDocs: docs.join('; '), docCount: docs.length,\n  uploadLink: client.uploadFormUrl + '?email=' + encodeURIComponent(client.email) } };"
      }
    },
