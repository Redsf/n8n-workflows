    {
      "id": "b6c1871c-d2bd-41c3-8c3c-572a07e429dd",
      "name": "Build Quote Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1696,
        112
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const req = $('Normalize Request').item.json;\nconst q = $json.output;\nconst money = (n) => '$' + Number(n || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\nreturn { json: { ...req, ...q,\n  lineItemsText: q.lineItems.map((l) => l.description + ' - ' + l.quantity + ' x ' + money(l.unitPrice) + ' = ' + money(l.amount)).join('\\n'),\n  totalText: money(q.total), assumptionsText: (q.assumptions || []).map((a) => '- ' + a).join('\\n'),\n  quoteDate: $now.toFormat('MMMM d, yyyy'), validUntil: $now.plus(30, 'days').toFormat('MMMM d, yyyy'),\n  fileName: 'Estimate - ' + req.name + ' - ' + $now.toFormat('yyyy-MM-dd') } };"
      }
    },
