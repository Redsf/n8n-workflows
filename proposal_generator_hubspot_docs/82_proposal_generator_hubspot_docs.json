      "id": "a865a279-a4d1-4eef-b274-051840933caa",
      "name": "Get Line Items",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        1136,
        492
      ],
      "parameters": {
        "method": "POST",
