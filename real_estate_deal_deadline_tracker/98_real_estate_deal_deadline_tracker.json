    {
      "id": "b51e9a1a-5f66-494f-90fa-c518f13ab509",
      "name": "Find Upcoming Deadlines",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        192
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// One sheet row per deal. A deadline counts as done when its \"<name>Done\" column says yes.\nconst MILESTONES = [\n  ['earnestMoneyDue', 'Earnest money due'], ['inspectionDeadline', 'Inspection contingency ends'],\n  ['appraisalDeadline', 'Appraisal contingency ends'], ['financingDeadline', 'Loan approval deadline'],\n  ['finalWalkthrough', 'Final walk-through'], ['closingDate', 'Closing'],\n];\nconst WARN_DAYS = 3;\nconst today = new Date(new Date().toISOString().slice(0, 10) + 'T00:00:00Z');\nconst out = [];\nfor (const { json: d } of $input.all()) {\n  for (const [key, label] of MILESTONES) {\n    if (!d[key] || /^y/i.test(String(d[key + 'Done'] || ''))) continue;\n    const days = Math.round((new Date(d[key] + 'T00:00:00Z') - today) / 86400000);\n    if (days > WARN_DAYS) continue;\n    out.push({ json: { address: d.address, client: d.client, agentName: d.agentName, agentEmail: d.agentEmail, milestone: label, date: d[key], daysLeft: days, overdue: days < 0 } });\n  }\n}\nreturn out.sort((a, b) => a.json.daysLeft - b.json.daysLeft);"
      }
    },
    {
      "id": "ce26431d-88ec-4d62-b8f6-b1b19a9d3c97",
      "name": "Overdue?",
      "type": "n8n-nodes-base.if",
