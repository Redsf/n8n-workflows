    {
      "id": "ff91fd2c-5f08-40f9-86ee-50b553e190a2",
      "name": "Split Uploaded Files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        112
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// One item per uploaded file, keeping the binary under \"data\".\nconst upload = $('Client Uploads Documents').first();\nreturn Object.entries(upload.binary || {}).map(([key, file]) => ({\n  json: { fileName: file.fileName, mimeType: file.mimeType },\n  binary: { data: file },\n}));"
      }
    },
