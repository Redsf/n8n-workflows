      "parameters": {
        "formTitle": "Save your seat",
        "formDescription": "Free live session. We will email you the link.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "First name",
              "fieldName": "firstName",
              "fieldType": "text",
              "requiredField": true
            },
            {
              "fieldLabel": "Email",
              "fieldName": "email",
              "fieldType": "email",
              "requiredField": true
            },
            {
              "fieldLabel": "Company",
              "fieldName": "company",
              "fieldType": "text"
            }
          ]
        },
        "responseMode": "onReceived",
        "options": {
          "path": "webinar-register",
          "appendAttribution": false,
          "respondWithOptions": {
            "values": {
              "respondWith": "text",
              "formSubmittedText": "You're registered! Check your inbox for the calendar invite."
            }
          }
        }
      },
      "webhookId": "f3682aff-59d3-4275-a469-35e631035920"
