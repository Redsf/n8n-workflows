              "type": "string"
            },
            {
              "id": "n7",
              "name": "budget",
              "value": "={{ $json.body.budget || '' }}",
              "type": "string"
            },
            {
              "id": "n8",
              "name": "message",
              "value": "={{ ($json.body.message || '').trim().slice(0, 3000) }}",
              "type": "string"
            },
            {
              "id": "n9",
              "name": "receivedAt",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        }
      }
