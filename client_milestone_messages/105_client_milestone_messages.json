      "parameters": {
        "promptType": "define",
        "hasOutputParser": true,
        "text": "=Client: {{ $json.name }}\nOccasion: {{ $json.occasion }}{{ $json.years ? ' (' + $json.years + ' years)' : '' }}\nProperty or policy: {{ $json.detail || 'not given' }}\nNotes: {{ $json.notes || 'none' }}",
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "=You write short, warm notes from {{ $json.agentName }} at {{ $json.businessName }} to a past client. Sound like a real person, not a brand. No sales pitch, no exclamation overload, no emojis in the email. Mention one personal detail if given. Email: 3-5 sentences. SMS: under 240 characters, ends with the agent's first name."
            }
          ]
        }
      }
    },
