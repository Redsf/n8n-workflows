{
  "id": "wlwwndtUyfOxDhEQ",
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "name": "Workflow Error Handler",
  "tags": [],
  "nodes": [
    {
      "id": "ad5c7b82-a3dc-4791-9504-822f1403e717",
      "name": "On Workflow Error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        240,
        396
      ],
      "parameters": {}
    },
    {
      "id": "40ab3f32-d8f8-4ff1-8818-46d00fed76b6",
      "name": "Format Error Details",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        464,
        396
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "e1",
              "name": "failedAt",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            },
            {
              "id": "e2",
              "name": "workflow",
              "value": "={{ $json.workflow?.name ?? \"unknown\" }}",
              "type": "string"
            },
            {
              "id": "e3",
              "name": "failedNode",
              "value": "={{ $json.execution?.lastNodeExecuted ?? \"unknown\" }}",
              "type": "string"
            },
            {
              "id": "e4",
              "name": "errorMessage",
              "value": "={{ ($json.execution?.error?.message ?? \"No message\").slice(0, 500) }}",
              "type": "string"
            },
            {
              "id": "e5",
              "name": "executionUrl",
              "value": "={{ $json.execution?.url ?? \"\" }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "fee15531-3a65-4b72-8602-5c734a3151e9",
      "name": "Alert #automation-alerts",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.7,
      "position": [
        688,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "post",
        "authentication": "oAuth2",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "automation-alerts"
        },
        "messageType": "text",
        "text": "=:x: *{{ $json.workflow }} failed*\nNode: {{ $json.failedNode }}\nError: {{ $json.errorMessage }}\n<{{ $json.executionUrl }}|Open the failed run>",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "credentials": {
        "slackOAuth2Api": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Slack account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "13666d5e-50b7-4b0d-be57-b3f14187cf29",
      "name": "Log to Error Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        688,
        492
      ],
      "parameters": {
        "resource": "sheet",
        "operation": "append",
        "authentication": "oAuth2",
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": "",
          "cachedResultName": "Automation Error Log"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Sheet1"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "schema": []
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      },
      "onError": "continueRegularOutput"
    }
  ],
  "active": false,
  "pinData": {},
  "settings": {
    "binaryMode": "separate",
    "executionOrder": "v1"
  },
  "versionId": "c29e4697-256a-4152-bb0b-ceb31e3cbefb",
  "nodeGroups": [],
  "connections": {
    "On Workflow Error": {
      "main": [
        [
          {
            "node": "Format Error Details",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Error Details": {
      "main": [
        [
          {
            "node": "Alert #automation-alerts",
            "type": "main",
            "index": 0
          },
          {
            "node": "Log to Error Sheet",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
