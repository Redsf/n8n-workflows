        "message": "=Hi {{ $('Find 3 Open Slots').item.json.firstName }},\n\nWe missed you for your {{ $('Find 3 Open Slots').item.json.service }}. No problem, these times are open this week. Pick one and it is booked.",
        "responseType": "customForm",
        "defineForm": "fields",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Pick a new time",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "={{ $('Find 3 Open Slots').item.json.slot1 }}"
                  },
                  {
                    "option": "={{ $('Find 3 Open Slots').item.json.slot2 }}"
                  },
                  {
                    "option": "={{ $('Find 3 Open Slots').item.json.slot3 }}"
                  },
                  {
                    "option": "None of these, please call me"
                  }
                ]
              }
            }
          ]
        },
        "options": {
          "appendAttribution": false,
          "messageButtonLabel": "Choose a time",
          "responseFormTitle": "Rebook your appointment",
          "limitWaitTime": {
            "values": {
              "limitType": "afterTimeInterval",
              "resumeAmount": 3,
              "resumeUnit": "days"
            }
          }
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      },
      "webhookId": "a8d7d39f-8337-4e0f-8da5-0f1999f6aa8a"
    },
    {
      "id": "8ab3d6f5-7af9-447f-9013-7110fa3703d4",
      "name": "Read Choice",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const p = $('Find 3 Open Slots').first().json;\nconst pick = $input.first().json.data?.['Pick a new time'] || '';\nconst i = [p.slot1, p.slot2, p.slot3].indexOf(pick);\nreturn [{ json: { ...p, picked: i >= 0, start: i >= 0 ? p.slots[i] : '', choice: pick || 'no answer' } }];"
      }
    },
