  },
  "name": "Missed-Call Reply Classifier",
  "tags": [],
  "nodes": [
    {
      "id": "b6260ea9-c04e-4f1d-b841-e03e98212058",
      "name": "Twilio Incoming SMS",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [
        240,
        684
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "missed-call-reply",
        "responseMode": "responseNode"
      }
    },
    {
      "id": "53ecff30-14b6-488d-9729-8e01312e3433",
      "name": "Acknowledge SMS",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        464,
        684
      ],
      "parameters": {
        "respondWith": "text",
        "responseBody": "<Response></Response>",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/xml"
              }
            ]
          }
        }
      }
    },
    {
      "id": "642e983b-1507-4344-a782-310efcc2d4bc",
      "name": "Normalize Reply",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        688,
        684
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "r1",
              "name": "fromPhone",
              "value": "={{ $json.body?.From ?? \"\" }}",
              "type": "string"
            },
            {
              "id": "r2",
              "name": "text",
              "value": "={{ String($json.body?.Body ?? \"\").trim().slice(0, 1000) }}",
              "type": "string"
            },
            {
              "id": "r3",
              "name": "receivedAt",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "4bdab7b2-33a7-4299-bfda-cfa05e35954b",
      "name": "Classify Reply",
      "type": "@n8n/n8n-nodes-langchain.textClassifier",
      "typeVersion": 1.1,
      "position": [
        912,
        684
      ],
      "parameters": {
        "inputText": "={{ $json.text }}",
        "categories": {
          "categories": [
            {
              "category": "urgent",
              "description": "Caller describes a deadline, emergency, angry tone, or asks for an immediate call back"
            },
            {
              "category": "wants_booking",
              "description": "Caller wants to schedule a meeting, consultation or call at a later time"
            },
            {
              "category": "question",
              "description": "Caller asks a question about services, pricing, hours or location"
            },
            {
              "category": "opt_out",
              "description": "Caller asks to stop texting, says wrong number, or is not interested"
            }
          ]
        },
        "options": {
          "fallback": "other",
          "enableAutoFixing": true
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "64a9be1f-678b-4589-a9b3-6289d43718fc",
      "name": "Claude Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.6,
      "position": [
        992,
        1004
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "claude-haiku-5-5"
        },
        "options": {
          "maxTokensToSample": 300
        }
      },
      "credentials": {}
    },
    {
      "id": "b5df7cd3-e7e5-4d02-839e-8deb180bb696",
      "name": "Tag: Urgent",
