    {
      "id": "93fee0f5-a08f-4aa7-a0c8-b42e97a8cbf3",
      "name": "Build Proposal Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1584,
        492
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const settings = $('Proposal Settings').first().json;\nconst deal = $('Get Deal and Associations').first().json;\nconst items = $('Get Line Items').first().json.results ?? [];\nconst contact = $('Get Primary Contact').first().json.properties ?? {};\n\nconst money = (n) => '$' + Number(n || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\nconst lines = items.map((li) => {\n  const p = li.properties ?? {};\n  const qty = Number(p.quantity || 1);\n  const amount = Number(p.amount || qty * Number(p.price || 0));\n  return { name: p.name || 'Item', description: p.description || '', qty, price: Number(p.price || 0), amount };\n});\nif (lines.length === 0) {\n  throw new Error(`Deal ${settings.dealId} has no readable line items`);\n}\nconst total = lines.reduce((sum, l) => sum + l.amount, 0);\nconst lineText = lines\n  .map((l) => `${l.name} (${l.qty} x ${money(l.price)}): ${money(l.amount)}${l.description ? '\\n   ' + l.description : ''}`)\n  .join('\\n');\nconst today = DateTime.now();\n\nreturn [{\n  json: {\n    dealId: settings.dealId,\n    dealName: deal.properties?.dealname || 'Proposal',\n    scope: deal.properties?.description || '',\n    clientFirstName: contact.firstname || 'there',\n    clientName: [contact.firstname, contact.lastname].filter(Boolean).join(' '),\n    clientEmail: contact.email || '',\n    clientCompany: contact.company || '',\n    lineItems: lineText,\n    total: money(total),\n    proposalDate: today.toFormat('LLLL d, yyyy'),\n    validUntil: today.plus({ days: settings.validDays }).toFormat('LLLL d, yyyy'),\n    fileName: `Proposal - ${contact.company || contact.lastname || 'Client'} - ${today.toFormat('yyyy-MM-dd')}`,\n  },\n}];"
      }
    },
