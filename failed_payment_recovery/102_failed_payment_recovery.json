      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Stripe sends invoice.payment_failed on every retry. Only the first attempt starts a recovery sequence.\nconst e = $input.first().json.body || {};\nconst inv = e.data?.object || {};\nif (e.type !== 'invoice.payment_failed' || inv.attempt_count !== 1 || !inv.customer_email) return [];\nreturn [{ json: { invoiceId: inv.id, email: inv.customer_email, name: inv.customer_name || '', firstName: (inv.customer_name || 'there').split(' ')[0],\n  phone: inv.customer_phone || '', amount: (inv.amount_due / 100).toFixed(2), currency: String(inv.currency || 'usd').toUpperCase(),\n  payLink: inv.hosted_invoice_url, businessName: 'Your Company', smsFromNumber: '+15550000000' } }];"
      }
    },
