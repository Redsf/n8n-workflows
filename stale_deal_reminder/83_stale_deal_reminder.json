      "typeVersion": 3.4,
      "position": [
        224,
        400
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "d1",
              "name": "staleDays",
              "value": 7,
              "type": "number"
            },
            {
              "id": "d2",
              "name": "escalateDays",
              "value": 14,
              "type": "number"
            },
            {
              "id": "d3",
              "name": "staleCutoffMs",
              "value": "={{ $now.minus(7, \"days\").toMillis() }}",
              "type": "string"
            },
            {
              "id": "d4",
              "name": "hubspotPortalId",
              "value": "0000000",
              "type": "string"
            },
            {
              "id": "d5",
              "name": "closedStages",
              "value": "closedwon,closedlost",
              "type": "string"
