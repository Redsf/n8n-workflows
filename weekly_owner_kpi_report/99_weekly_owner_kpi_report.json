    {
      "id": "c7824a5a-4f39-4f2c-9779-7507c935e063",
      "name": "Calculate KPIs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        112
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const real = (name) => $(name).all().map((i) => i.json).filter((j) => j && Object.keys(j).length);\nconst sum = (rows, f) => rows.reduce((t, r) => t + Number(f(r) || 0), 0);\nconst s = $('Report Settings').first().json;\nconst inv = real('Get Invoices This Week'), pay = real('Get Payments This Week'), od = real('Get Overdue Invoices');\nconst leads = real('Get New Leads'), won = real('Get Deals Won');\nconst money = (n) => '$' + Math.round(n).toLocaleString('en-US');\nconst k = {\n  weekStart: s.weekStart,\n  invoiced: sum(inv, (r) => r.TotalAmt), invoiceCount: inv.length,\n  collected: sum(pay, (r) => r.TotalAmt),\n  overdueBalance: sum(od, (r) => r.Balance), overdueCount: od.length,\n  newLeads: leads.length,\n  dealsWon: won.length, wonValue: sum(won, (r) => r.properties?.amount),\n  revenueGoal: s.revenueGoal,\n};\nk.goalPct = k.revenueGoal ? Math.round((k.collected / k.revenueGoal) * 100) : null;\nk.table = ['Invoiced: ' + money(k.invoiced) + ' (' + k.invoiceCount + ' invoices)', 'Collected: ' + money(k.collected) + (k.goalPct !== null ? ' (' + k.goalPct + '% of weekly goal)' : ''),\n  'Overdue: ' + money(k.overdueBalance) + ' across ' + k.overdueCount + ' invoices', 'New leads: ' + k.newLeads, 'Deals won: ' + k.dealsWon + ' worth ' + money(k.wonValue)].join('\\n');\nreturn [{ json: k }];"
      }
    },
