        "authentication": "oAuth2",
        "returnAll": true,
        "filterGroupsUi": {
          "filterGroupsValues": [
            {
              "filtersUi": {
                "filterValues": [
                  {
                    "propertyName": "notes_last_updated|datetime",
                    "operator": "LT",
                    "value": "={{ $json.staleCutoffMs }}"
                  },
                  {
                    "propertyName": "dealstage|enumeration",
                    "operator": "NEQ",
                    "value": "closedwon"
                  },
                  {
                    "propertyName": "dealstage|enumeration",
                    "operator": "NEQ",
                    "value": "closedlost"
                  }
                ]
              }
            },
            {
              "filtersUi": {
                "filterValues": [
                  {
                    "propertyName": "notes_last_updated|datetime",
                    "operator": "NOT_HAS_PROPERTY"
                  },
                  {
                    "propertyName": "createdate|datetime",
                    "operator": "LT",
                    "value": "={{ $json.staleCutoffMs }}"
                  },
                  {
                    "propertyName": "hs_is_closed|bool",
                    "operator": "NEQ",
                    "value": "true"
                  }
                ]
              }
            }
          ]
        },
        "additionalFields": {
          "properties": [
            "dealname",
            "amount",
            "dealstage",
            "hubspot_owner_id",
