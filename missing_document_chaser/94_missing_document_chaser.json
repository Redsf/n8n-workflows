    {
      "id": "3fbb92cb-f661-4660-8ebf-5b5d5dfce1cf",
      "name": "Pick Clients to Chase",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Uses the onboarding tracker: email, contactName, clientName, missingDocs (\"a; b; c\"), reminderCount, lastReminder, status\nconst s = $('Chase Settings').first().json;\nconst now = new Date();\nconst daysLeft = Math.ceil((new Date(s.filingDeadline + 'T00:00:00Z') - now) / 86400000);\nconst out = [];\nfor (const { json: r } of $input.all()) {\n  const missing = String(r.missingDocs || '').split(';').map((d) => d.trim()).filter(Boolean);\n  if (!missing.length || !r.email) continue;\n  const last = r.lastReminder ? new Date(r.lastReminder) : null;\n  if (last && (now - last) / 86400000 < s.daysBetweenReminders) continue;\n  const count = Number(r.reminderCount || 0);\n  out.push({ json: { row_number: r.row_number, email: r.email, clientName: r.clientName, firstName: String(r.contactName || 'there').split(' ')[0],\n    missing, count, escalate: count >= s.remindersBeforeEscalating, daysLeft,\n    uploadLink: s.uploadFormUrl + '?email=' + encodeURIComponent(r.email) } });\n}\nreturn out;"
      }
    },
