      "webhookId": "4da2d904-3c1c-4c8d-b6de-82baeb74ffa4"
    },
    {
      "id": "8d8f276d-4a81-42b3-8509-96923b131a33",
      "name": "Build Daily Board",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        384
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const rows = $('Find Upcoming Deadlines').all().map((i) => i.json);\nconst line = (r) => (r.overdue ? ':red_circle: ' : r.daysLeft === 0 ? ':large_orange_circle: ' : ':large_yellow_circle: ') + r.date + '  ' + r.milestone + ' - ' + r.address + ' (' + r.agentName + ')';\nreturn [{ json: { text: '*Deal deadlines, next 3 days* (' + rows.length + ')\\n' + rows.map(line).join('\\n') } }];"
      }
    },
