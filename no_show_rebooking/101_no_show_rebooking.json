    },
    {
      "id": "c2f70af9-18ee-4ddc-bb8a-c69ddb6fa283",
      "name": "Normalize No-Show",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Accepts the no-show from your booking tool: name, email, phone, service, appointmentTime.\nconst b = $input.first().json.body || {};\nreturn [{ json: { name: b.name || '', firstName: (b.name || 'there').split(' ')[0], email: String(b.email || '').trim().toLowerCase(),\n  phone: b.phone || '', service: b.service || 'appointment', missedAt: b.appointmentTime || '',\n  businessName: 'Your Clinic', smsFromNumber: '+15550000000', calendarId: 'primary', slotMinutes: 60, openHour: 9, closeHour: 17 } }];"
      }
    },
    {
      "id": "d4f137bc-46ac-4c56-b397-5fe5878a7207",
      "name": "Has Email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        448,
        96
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test($json.email) }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "7d734579-5e05-4903-b230-17085c737aef",
      "name": "Get Booked Events",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.4,
      "position": [
        672,
        96
      ],
      "parameters": {
        "resource": "event",
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Normalize No-Show').item.json.calendarId }}"
        },
        "returnAll": true,
        "timeMin": "={{ $now.plus(1, 'day').startOf('day').toISO() }}",
        "timeMax": "={{ $now.plus(6, 'days').endOf('day').toISO() }}",
        "options": {
          "orderBy": "startTime",
          "recurringEventHandling": "expand"
        }
      },
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Google Calendar"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "c1394457-413a-42c7-80b4-cd905c89c30e",
      "name": "Find 3 Open Slots",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Walk the next 5 weekdays in business hours and keep the first 3 free slots.\nconst p = $('Normalize No-Show').first().json;\nconst busy = $input.all().map(i => i.json).filter(e => e.start && e.end)\n  .map(e => [new Date(e.start.dateTime || e.start.date), new Date(e.end.dateTime || e.end.date)]);\nconst slots = [];\nconst day = new Date(); day.setDate(day.getDate() + 1);\nfor (let d = 0; d < 10 && slots.length < 3; d++, day.setDate(day.getDate() + 1)) {\n  if ([0, 6].includes(day.getDay())) continue;\n  for (let h = p.openHour; h + p.slotMinutes / 60 <= p.closeHour && slots.length < 3; h++) {\n    const s = new Date(day); s.setHours(h, 0, 0, 0);\n    const e = new Date(s.getTime() + p.slotMinutes * 60000);\n    if (!busy.some(([bs, be]) => s < be && e > bs)) { slots.push(s); h += 2; }\n  }\n}\nconst label = s => s.toLocaleString('en-US', { weekday: 'long', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });\nreturn [{ json: { ...p, slots: slots.map(s => s.toISOString()), slot1: label(slots[0]), slot2: label(slots[1]), slot3: label(slots[2]) } }];"
      }
    },
    {
      "id": "8dc32966-f43c-45ff-97a3-943a274c0afc",
