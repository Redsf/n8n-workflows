{
  "name": "Old Lead Revival",
  "nodes": [
    {
      "id": "c82b56dd-9f56-473e-becf-be2c08dfdece",
      "name": "Weekdays 9 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        304
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 1-5"
            }
          ]
        }
      }
    },
    {
      "id": "740f1945-973d-40f9-8c0c-28faab730a85",
      "name": "Revival Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        224,
        304
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "v1",
              "name": "businessName",
              "value": "Your Company",
              "type": "string"
            },
            {
              "id": "v2",
              "name": "senderName",
              "value": "Alex from Your Company",
              "type": "string"
            },
            {
              "id": "v3",
              "name": "bookingUrl",
              "value": "https://calendly.com/your-team/discovery-call",
              "type": "string"
            },
            {
              "id": "v4",
              "name": "staleDays",
              "value": 90,
              "type": "number"
            },
            {
              "id": "v5",
              "name": "dailyCap",
              "value": 15,
              "type": "number"
            },
            {
              "id": "v6",
              "name": "cutoffMs",
              "value": "={{ $now.minus(90, \"days\").toMillis() }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "e4f0efbf-8d35-4006-8181-9b0f3f61d058",
      "name": "Find Cold Leads",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2.2,
      "position": [
        448,
        304
      ],
      "parameters": {
        "resource": "contact",
        "operation": "search",
        "authentication": "oAuth2",
        "returnAll": false,
        "limit": "={{ $json.dailyCap }}",
        "filterGroupsUi": {
          "filterGroupsValues": [
            {
              "filtersUi": {
                "filterValues": [
                  {
                    "propertyName": "lifecyclestage|enumeration",
                    "operator": "EQ",
                    "value": "lead"
                  },
                  {
                    "propertyName": "notes_last_updated|datetime",
                    "operator": "LT",
                    "value": "={{ $json.cutoffMs }}"
                  },
                  {
                    "propertyName": "hs_email_optout|bool",
                    "operator": "NEQ",
                    "value": "true"
                  }
                ]
              }
            }
          ]
        },
        "additionalFields": {
          "properties": [
            "firstname",
            "lastname",
            "email",
            "company",
            "jobtitle",
            "message",
            "notes_last_updated"
          ],
          "sortBy": "notes_last_updated",
          "direction": "ASCENDING"
        }
      },
      "credentials": {
        "hubspotOAuth2Api": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "HubSpot account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "39ba4456-3135-4076-8b2f-d70b38ede7c2",
      "name": "Has Email",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        672,
        304
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.properties?.email ?? \"\" }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "8396020a-0e41-4314-87f9-245bfb92c421",
      "name": "Post Daily Summary",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.7,
      "position": [
        1184,
        0
      ],
      "parameters": {
        "resource": "message",
        "operation": "post",
        "authentication": "oAuth2",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "lead-revival"
        },
        "messageType": "text",
        "text": "=:recycle: Lead revival done for {{ $now.toFormat('cccc d LLL') }}: {{ $input.all().filter(i => i.json.outcome === 'sent').length }} sent, {{ $input.all().filter(i => i.json.outcome !== 'sent').length }} skipped.",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "credentials": {
        "slackOAuth2Api": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Slack account"
        }
      },
      "executeOnce": true,
      "onError": "continueRegularOutput"
    },
    {
      "id": "196bece4-9974-49ac-8084-ca8e6b1180f3",
      "name": "Write Revival Email",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1120,
        304
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Lead: {{ $json.properties.firstname || 'there' }} {{ $json.properties.lastname || '' }}, {{ $json.properties.jobtitle || 'unknown role' }} at {{ $json.properties.company || 'unknown company' }}.\nWhat they originally asked about: {{ $json.properties.message || 'no notes' }}\nLast activity: {{ $json.properties.notes_last_updated || 'unknown' }}",
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "=You write short re-engagement emails for {{ $('Revival Settings').first().json.businessName }}. Write the BODY only: no subject, no greeting line, no sign-off. 60 to 110 words, plain text, two or three short paragraphs. Reference what they asked about if known, offer one concrete idea that might help now, and end with a low-pressure question. Never invent facts, prices, results or past conversations. No exclamation marks, no buzzwords."
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 2
    },
    {
      "id": "d8ab2f51-eeb1-4d77-8ae7-3260af60d313",
      "name": "Claude Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.6,
      "position": [
        1200,
        528
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "claude-haiku-5-5"
        },
        "options": {
          "maxTokensToSample": 600
        }
      },
      "credentials": {}
    },
    {
      "id": "23782e01-42d5-4a19-82a3-74dff9cc125e",
      "name": "Ask for Approval",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.7,
      "position": [
        1472,
        304
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendAndWait",
        "authentication": "oAuth2",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "lead-revival"
        },
        "message": "=*Re-engage {{ $('One Lead at a Time').item.json.properties.firstname }} {{ $('One Lead at a Time').item.json.properties.lastname || '' }}* ({{ $('One Lead at a Time').item.json.properties.company || 'no company' }}, {{ $('One Lead at a Time').item.json.properties.email }})\nSubject: Checking in, {{ $('One Lead at a Time').item.json.properties.firstname || 'there' }}\n\n{{ $json.text }}",
        "responseType": "approval",
        "approvalOptions": {
          "values": {
            "approvalType": "double",
            "approveLabel": "Send it",
            "disapproveLabel": "Skip"
          }
        },
        "options": {
          "limitWaitTime": {
            "values": {
              "limitType": "afterTimeInterval",
              "resumeAmount": 24,
              "resumeUnit": "hours"
            }
          },
          "appendAttribution": false
        }
      },
      "credentials": {
        "slackOAuth2Api": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Slack account"
        }
      }
    },
    {
      "id": "d1b069b1-c81e-4615-a69b-002af555a553",
      "name": "Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1696,
        304
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.data?.approved === true }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "68d7d68e-40cb-481d-9ac0-ea0ca35f7759",
      "name": "Send Revival Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        1920,
        208
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $('One Lead at a Time').item.json.properties.email }}",
        "subject": "=Checking in, {{ $('One Lead at a Time').item.json.properties.firstname || 'there' }}",
        "emailType": "html",
        "message": "=<div style=\"font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#1a1a1a;max-width:560px\"><p>Hi {{ $('One Lead at a Time').item.json.properties.firstname || 'there' }},</p>{{ $('Write Revival Email').item.json.text.trim().split(/\\n\\s*\\n/).map(p => '<p>' + p.replace(/\\n/g, '<br>') + '</p>').join('') }}<p>If it helps, you can grab a time here: <a href=\"{{ $('Revival Settings').first().json.bookingUrl }}\">book a call</a>.</p><p>Best,<br>{{ $('Revival Settings').first().json.senderName }}</p><p style=\"font-size:12px;color:#888\">Not interested? Just reply \"no thanks\" and we will not email again.</p></div>",
        "options": {
          "appendAttribution": false,
          "senderName": "={{ $('Revival Settings').first().json.senderName }}"
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "id": "17050693-ab65-4921-9cf3-79b6d02c62e0",
      "name": "Log Email in HubSpot",
