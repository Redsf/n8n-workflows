      ],
      "parameters": {
        "resource": "engagement",
        "operation": "create",
        "authentication": "oAuth2",
        "type": "task",
        "metadata": {
          "subject": "=Call unhappy customer: {{ $('Normalize Job').item.json.firstName }} ({{ $('Normalize Job').item.json.email }})",
          "body": "=Rated {{ $('Read Rating').item.json.rating }}/5 after {{ $('Normalize Job').item.json.jobType }}. Comment: {{ $('Read Rating').item.json.comment || 'none' }}",
          "status": "NOT_STARTED"
        },
        "additionalFields": {},
        "dueDate": "={{ $now.plus(1, 'day').toFormat('yyyy-MM-dd HH:mm:ss') }}"
      },
      "credentials": {
        "hubspotOAuth2Api": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "HubSpot account"
        }
      }
    },
