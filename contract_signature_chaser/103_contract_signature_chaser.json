    {
      "id": "72415ccd-b1b1-42e0-8246-8988e6a5808d",
      "name": "Pick Contracts to Chase",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        192
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Remind 2 and 4 days after sending, final reminder at day 7, escalate to the owner at day 9.\nconst today = new Date($('Chaser Settings').first().json.today + 'T00:00:00Z');\nconst out = [];\nfor (const item of $input.all()) {\n  const c = item.json;\n  if (!c.email || !c.sentDate) continue;\n  const days = Math.round((today - new Date(String(c.sentDate).slice(0, 10) + 'T00:00:00Z')) / 86400000);\n  const stage = { 2: 'reminder', 4: 'reminder', 7: 'final', 9: 'escalate' }[days];\n  if (!stage) continue;\n  out.push({ json: { row_number: c.row_number, firstName: (c.clientName || 'there').split(' ')[0], clientName: c.clientName, email: c.email,\n    contractName: c.contractName, signLink: c.signLink, ownerEmail: c.ownerEmail || '', daysWaiting: days, stage } });\n}\nreturn out;"
      }
    },
    {
      "id": "e9b80f7e-d268-4957-b240-5a9ec40e8e7f",
      "name": "Route by Stage",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        896,
        192
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "renameOutput": true,
              "outputKey": "reminder",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.stage }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "reminder"
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "renameOutput": true,
              "outputKey": "final",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.stage }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "final"
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "renameOutput": true,
              "outputKey": "escalate",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.stage }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "escalate"
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "options": {}
      }
    },
