                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "d09ea67e-b67b-4ebf-8336-e1dd723d5e96",
      "name": "Alert Overdue Deadline",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
        896,
