    {
      "id": "17bc7dfc-8765-4a7e-bd80-ce36c1c0c0cd",
      "name": "Update Checklist",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1696,
        112
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const row = $('Find Client in Tracker').first().json;\nlet missing = String(row.missingDocs || '').split(';').map((s) => s.trim()).filter(Boolean);\nconst received = [], issues = [];\n$input.all().forEach((item, i) => {\n  const r = item.json.output || {};\n  const file = $('Split Uploaded Files').all()[i]?.json.fileName || 'file';\n  if (r.matchedItem && r.readable !== false) { received.push(r.matchedItem); missing = missing.filter((d) => d !== r.matchedItem); }\n  else issues.push(file + ': ' + (r.issue || 'we could not match this file to the checklist'));\n});\nreturn [{ json: { row_number: row.row_number, clientName: row.clientName, contactName: row.contactName, email: row.email,\n  missingDocs: missing.join('; '), received, issues, allIn: missing.length === 0 } }];"
      }
    },
