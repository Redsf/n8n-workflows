        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ properties: [\"name\", \"description\", \"quantity\", \"price\", \"amount\"], inputs: ($json.associations?.[\"line items\"]?.results ?? $json.associations?.line_items?.results ?? []).map(r => ({ id: r.id })) }) }}",
