      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $('Normalize Lead').item.json.email }}",
        "subject": "=Thanks for reaching out, {{ $('Normalize Lead').item.json.firstName }}",
        "emailType": "html",
        "message": "=<div style=\"font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#1a1a1a;max-width:560px\"><p>Hi {{ $('Normalize Lead').item.json.firstName }},</p><p>Thanks for contacting {{ $('Business Settings').item.json.businessName }}. We got your message and someone from our team will reach out shortly.</p><p>If you would rather not wait, pick a time that suits you and we will come prepared:</p><p><a href=\"{{ $('Business Settings').item.json.bookingUrl }}\" style=\"display:inline-block;background:#111827;color:#ffffff;padding:12px 22px;border-radius:6px;text-decoration:none;font-weight:bold\">Book a call</a></p><p>Best,<br>{{ $('Business Settings').item.json.senderName }}</p></div>",
        "options": {
          "appendAttribution": false,
          "senderName": "={{ $('Business Settings').item.json.senderName }}"
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
